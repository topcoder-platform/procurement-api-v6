# PostgreSQL Database URL for Prisma.
# Use a database/schema dedicated to procurement-api-v6 when running locally.
DATABASE_URL="postgresql://user:password@localhost:5432/procurement?schema=public"

# JWT Authentication (from tc-core-library-js).
AUTH_SECRET="mysecret"
VALID_ISSUERS='["https://topcoder-dev.auth0.com/","https://api.topcoder.com"]'

# Optional HTTP port. Defaults to 3000.
PORT=3000
